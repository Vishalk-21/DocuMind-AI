NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=your_mongodb_connection_string

GEMINI_API_KEY=your_gemini_api_key
QDRANT_URL=https://your-qdrant-host
QDRANT_API_KEY=your_qdrant_api_key

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Gmail: use smtp.gmail.com, port 587, and a  Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=your@gmail.com

# Recommended for Render: Resend uses HTTPS instead of SMTP.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=DocuMind AI <onboarding@resend.dev>

JWT_SECRET=replace_with_a_long_random_secret

GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
GROQ_GRAPH_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_CHAT_MODEL=llama3.1-8b
CEREBRAS_SUMMARY_MODEL=llama3.1-8b
CEREBRAS_GRAPH_MODEL=llama3.1-8b

GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-3.6-flash
GEMINI_GRAPH_MODEL=gemini-3.6-flash

UPLOAD_DIR=uploads
